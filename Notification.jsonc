{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "offer",
        "system",
        "vendor",
        "company",
        "payment",
        "membership"
      ],
      "default": "system"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "system"
      ],
      "default": "system"
    },
    "audience": {
      "type": "string",
      "enum": [
        "all",
        "specific_users",
        "businesses",
        "countries",
        "membership",
        "companies"
      ],
      "default": "all"
    },
    "target_user_id": {
      "type": "string"
    },
    "target_company_id": {
      "type": "string"
    },
    "target_country": {
      "type": "string"
    },
    "target_membership_plan": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "sent_by_admin": {
      "type": "boolean",
      "default": false
    },
    "admin_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.target_user_id": "{{user.id}}"
        },
        {
          "data.recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.target_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}