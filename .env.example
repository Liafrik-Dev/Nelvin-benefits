# ============================================================
# Nelvin Benefits — Environment variables
# Copy this file to `.env` and fill in the values for local development.
# NEVER commit the real `.env` file — it contains secrets.
# ============================================================

# Base44 application identifier (from the Base44 console.
VITE_BASE44_APP_ID=

# Base44 functions version (leave empty to use the default)
VITE_BASE44_FUNCTIONS_VERSION=

# Base44 platform base URL (used by the Base44 SDK / bootstrap
VITE_BASE44_APP_BASE_URL=

# Optional: api base URL used by the app when deployed (defaults to same origin
# VITE_API_BASE_URL=