{
  "name": "Lead",
  "type": "object",
  "properties": {
    "business_id": { "type": "string" },
    "company_name": { "type": "string" },
    "contact_name": { "type": "string" },
    "contact_email": { "type": "string" },
    "phone": { "type": "string" },
    "notes": { "type": "string" },
    "status": { "type": "string", "enum": ["new", "contacted", "converted", "lost"], "default": "new" }
  },
  "required": ["company_name", "contact_email"]
}